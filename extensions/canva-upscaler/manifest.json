{
  "manifest_version": 3,
  "name": "PaletteIQ Canva Upscaler Companion",
  "version": "0.3.0",
  "description": "Experimental PaletteIQ Canva transfer and single-image Upscale action.",
  "permissions": [
    "downloads",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:18763/*",
    "https://www.canva.com/*"
  ],
  "action": {
    "default_title": "PaletteIQ Canva Companion",
    "default_popup": "popup.html"
  }
}
