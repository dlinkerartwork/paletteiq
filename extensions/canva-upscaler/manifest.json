{
  "manifest_version": 3,
  "name": "PaletteIQ Canva Upscaler Companion",
  "version": "0.5.5",
  "description": "Experimental PaletteIQ Canva transfer and single-image Upscale action.",
  "permissions": [
    "downloads",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:18763/*",
    "https://www.canva.com/*"
  ],
  "action": {
    "default_title": "PaletteIQ Canva Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:18763/*"
      ],
      "js": [
        "sidebar.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js"
      ],
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:18763/*"
      ]
    }
  ]
}
