{
  "manifest_version": 3,
  "name": "PaletteIQ Canva Upscaler Companion",
  "version": "0.2.0",
  "description": "Send PaletteIQ images to Canva using a user-triggered upload attempt and return upscaled assets.",
  "permissions": [
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:18763/*",
    "https://www.canva.com/*"
  ],
  "action": {
    "default_title": "PaletteIQ Canva Companion",
    "default_popup": "popup.html"
  }
}
