# PaletteIQ Desktop SMTP defaults (copy these lines into the repository-root .env)
# Installer packaging stages ONLY these SMTP keys; other .env API keys stay local.
# WARNING: The bundled SMTP password can be extracted from the installer.
# Use a dedicated Gmail sender account with 2-Step Verification + App Password.
PALETTEIQ_SMTP_HOST=smtp.gmail.com
PALETTEIQ_SMTP_PORT=587
PALETTEIQ_SMTP_USERNAME=sender@gmail.com
PALETTEIQ_SMTP_FROM=sender@gmail.com
PALETTEIQ_SMTP_PASSWORD=YOUR_16_CHARACTER_GOOGLE_APP_PASSWORD
